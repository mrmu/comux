# Database
# Node 跑在 host，連容器 DB 走 localhost:5432 (docker-compose.production.yml
# 已把 db 綁到 127.0.0.1:5432)
DATABASE_URL=postgresql://comux:comux@localhost:5432/comux?schema=public
POSTGRES_PASSWORD=comux

# Auth JWT secret —— 必填，本機開發也一樣。
# 用 `openssl rand -hex 32` 產生；未設、短於 32 字元或等於任何公開預設值時
# 伺服器會直接拒絕啟動（不會再退回預設值）。
COMUX_SECRET=

# Production
PROJECTS_ROOT=/home/devops/projects

# 監聽位址：預設 127.0.0.1（只給本機的 Tailscale Serve 轉進來）。
# 不要改成 0.0.0.0 —— comux 等於這台主機的網頁 shell。
# HOSTNAME=127.0.0.1

# WebSocket / CSRF 的 origin allowlist（逗號分隔的 hostname）
# 用 Tailscale Serve 時填這台機器的 MagicDNS 名稱，例如：
ALLOWED_ORIGINS=your-host.your-tailnet.ts.net,localhost

# （不建議）nginx-proxy 公網模式才需要，見 docker-compose.production.yml 的警告
# VIRTUAL_HOST=comux.example.com
# LETSENCRYPT_EMAIL=admin@example.com

# Cloudflare (選用，DNS 管理功能才需要)
CF_API_TOKEN=
CF_ZONE_ID=

# Dev only
NEXT_PUBLIC_WS_PORT=3001
