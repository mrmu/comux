# Database
# Node 跑在 host，連容器 DB 走 localhost:5432 (docker-compose.production.yml
# 已把 db 綁到 127.0.0.1:5432)
DATABASE_URL=postgresql://comux:comux@localhost:5432/comux?schema=public
POSTGRES_PASSWORD=comux

# Auth JWT secret —— 必填，本機開發也一樣。
# 用 `openssl rand -hex 32` 產生；未設、短於 32 字元或等於任何公開預設值時
# 伺服器會直接拒絕啟動（不會再退回預設值）。
COMUX_SECRET=

# 第一個管理員註冊用的 setup token（選用）。不設時，系統沒有使用者的情況下
# comux 啟動會隨機產生一組印在 log；設了就用這個值（至少 16 字元）。
# COMUX_SETUP_TOKEN=

# Production
PROJECTS_ROOT=/home/deploy/projects

# 監聽位址：預設 127.0.0.1（只給本機的 Tailscale Serve 轉進來）。
# 不要改成 0.0.0.0 —— comux 等於這台主機的網頁 shell。
# HOSTNAME=127.0.0.1

# 可信的反向代理位址（逗號分隔）。只有連線來自這些位址時，才採用
# X-Forwarded-For 當作客戶端位址（登入限流用）；未設時一律用 socket 實際位址。
# 用 Tailscale Serve 時它從本機連進來，設成 loopback 才能依 tailnet 裝置分別限流：
# TRUSTED_PROXIES=127.0.0.1,::1

# WebSocket / CSRF 的 origin allowlist（逗號分隔的 hostname）
# 用 Tailscale Serve 時填這台機器的 MagicDNS 名稱，例如：
ALLOWED_ORIGINS=your-host.your-tailnet.ts.net,localhost

# （不建議）nginx-proxy 公網模式才需要，見 docker-compose.production.yml 的警告
# VIRTUAL_HOST=comux.example.com
# LETSENCRYPT_EMAIL=admin@example.com

# Cloudflare (選用，DNS 管理功能才需要)
CF_API_TOKEN=
CF_ZONE_ID=

# 安全事件通知（建議設定）：登入成功／失敗、第二道驗證變更、互動式 SSH。
# 設了哪個就送哪個，可同時設；都沒設就只寫稽核紀錄（Audit 頁）、不通知。
# COMUX_TELEGRAM_BOT_TOKEN=
# COMUX_TELEGRAM_CHAT_ID=
# 通用 webhook：POST JSON {text, content}（Slack / Discord / Google Chat / 自架接收端）
# COMUX_NOTIFY_WEBHOOK_URL=
# 通知裡顯示的主機名稱（預設 os.hostname()）
# COMUX_INSTANCE_NAME=
# SSH 通知範圍：interactive（預設，只通知互動式登入）/ all / none
# COMUX_NOTIFY_SSH=interactive
# SSH 監看：掃描間隔（毫秒，預設 5000）；設 off 關閉
# COMUX_SSH_POLL_MS=5000
# COMUX_SSH_AUDIT=on

# Dev only
NEXT_PUBLIC_WS_PORT=3001
